# Empty template. Keep real runtime values in .dev.vars or your hosting secrets.
# Local development needs no credentials. Production requires an auth mode.
MEDIA_TRACKER_AUTH_MODE=
MEDIA_TRACKER_OWNER_HASH=
# For standalone Cloudflare Workers, use cloudflare-access and fill these in.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional official MyAnimeList client ID; Jikan is used when this is absent.
MYANIMELIST_CLIENT_ID=
# Optional licensed IMDb integration; requires a separate AWS Data Exchange subscription.
IMDB_AWS_ACCESS_KEY_ID=
IMDB_AWS_SECRET_ACCESS_KEY=
IMDB_AWS_SESSION_TOKEN=
IMDB_DATA_SET_ID=
IMDB_REVISION_ID=
IMDB_ASSET_ID=
IMDB_API_KEY=
