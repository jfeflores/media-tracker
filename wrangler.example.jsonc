{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "media-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "media-tracker", "database_id": "REPLACE_WITH_YOUR_DATABASE_ID" }
  ],
  "vars": { "MEDIA_TRACKER_AUTH_MODE": "cloudflare-access" }
}
